{
  "name": "football-quiz",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "dev:web:lan": "npm run dev:lan -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint -w apps/web",
    "preview:web:lan": "npm run build -w apps/web && npm run start:lan -w apps/web -- -p 3001",
    "quality:architecture": "node tools/quality/architecture-check.mjs",
    "quality:bundle": "node tools/quality/bundle-budget.mjs",
    "quality": "tools/quality/check.sh",
    "test": "npm run test -w apps/web",
    "test:coverage": "npm run test:coverage -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "typecheck": "npm run typecheck -w apps/web"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
